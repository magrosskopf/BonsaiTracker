{
  "name": "bonsai-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "supabase:start": "node scripts/run-supabase-cli.js start --exclude vector",
    "supabase:stop": "node scripts/run-supabase-cli.js stop",
    "supabase:reset": "node scripts/run-supabase-cli.js db reset",
    "test:db": "node scripts/run-supabase-cli.js test db",
    "supabase:types": "tsx scripts/generate-supabase-types.ts",
    "supabase:types:check": "tsx scripts/check-supabase-types.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/run-supabase-integration-tests.ts",
    "validate:local-supabase": "tsx scripts/run-local-supabase-validation.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "autoprefixer": "^10.x",
    "multer": "^2.0.0",
    "next": "15.3.6",
    "next-connect": "^1.0.0-next.4",
    "postcss": "^8.x",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "swiper": "^11.2.8",
    "tailwindcss": "^3.x",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.24",
    "@types/react": "19.1.6",
    "@types/swiper": "^6.0.0",
    "autoprefixer": "^10.0.0",
    "daisyui": "^5.0.54",
    "postcss": "^8.0.0",
    "supabase": "^2.109.1",
    "tsx": "^4.19.3",
    "typescript": "^4.0.0"
  }
}
